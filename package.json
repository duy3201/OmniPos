{
  "name": "omnipos",
  "version": "1.0.0",
  "private": true,
  "description": "OmniPOS - Hệ thống POS & Quản lý Kho Dành Cho Cửa Hàng Vật Tư Thủy Sản",
  "scripts": {
    "dev:web": "pnpm --filter @omnipos/web dev",
    "dev:api": "pnpm --filter @omnipos/api start:dev",
    "build:web": "pnpm --filter @omnipos/web build",
    "build:api": "pnpm --filter @omnipos/api build",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
